# Godot 4 .gitignore

# Godot-specific ignores
.godot/
*.translation
export_presets.cfg

# Export / Web build artifacts
*.pck
*.wasm
*.audio.worklet.js
*.audio.position.worklet.js
Rift Runner.*
build/
dist/
export/

# Mono/C# specific
.mono/
data_*/
mono_crash.*.json

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor temp files
*.tmp
*.bak
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
