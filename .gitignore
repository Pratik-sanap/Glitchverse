# Godot 4 .gitignore

# Godot-specific ignores
.godot/
*.translation
export_presets.cfg

# Export / Web build artifacts (keep non-web exports ignored)
build/
dist/
export/

# Allow web export files for GitHub Pages deployment
# (Rift Runner.html, .js, .wasm, .pck, .png, .icon.png, etc. are tracked)

# Mono/C# specific
.mono/
data_*/
mono_crash.*.json

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor temp files
*.tmp
*.bak
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
